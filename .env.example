# Purse — development environment template.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit it, and never put a real secret in a compose
# file, a Dockerfile, or a docs snippet — configuration is env vars only.

# --- Postgres (service: db) ---------------------------------------------------
# Required. docker-compose.dev.yml fails fast if this is unset.
POSTGRES_PASSWORD=changeme
# Optional overrides; the defaults in docker-compose.dev.yml are used if unset.
POSTGRES_USER=purse
POSTGRES_DB=purse
# Host port the db is published on. Change if 5432 is already taken locally.
POSTGRES_PORT=5432

# --- Application (service: app) ----------------------------------------------
# Connection string the app uses. Host is the compose service name, not localhost.
# postgresql:// and postgres:// are both accepted; Purse rewrites the driver to
# psycopg 3 internally.
DATABASE_URL=postgresql://purse:changeme@db:5432/purse

# --- Tests -------------------------------------------------------------------
# Where the database tests may create and drop throwaway databases. Preferred
# over DATABASE_URL so running the suite can never touch a real deployment.
# Host is localhost here, not the compose service name: pytest runs outside the
# compose network, against the published port.
# With neither variable set, the database tests skip. Set REQUIRE_DB=1 (as CI
# does) to turn that skip into a failure.
# TEST_DATABASE_URL=postgresql://purse:changeme@localhost:5432/purse

# Public base URL of this instance. Used for OAuth discovery metadata, issuer,
# and redirect validation — must match how clients actually reach the server.
# PURSE_BASE_URL=http://localhost:8000

# Log level: debug | info | warning | error. Secret material is never logged at
# any level.
# PURSE_LOG_LEVEL=info

# --- Encryption (C6, not yet implemented) ------------------------------------
# Path to the local master keyfile that wraps per-secret data encryption keys.
# Mount it as a read-only volume; back it up separately from the database, or
# encrypted API keys become unrecoverable. Leave unset to use a cloud KMS.
# PURSE_MASTER_KEYFILE=/run/secrets/purse-master.key
# PURSE_KMS_KEY_ID=
