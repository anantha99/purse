# ---------------------------------------------------------------------------
# Purse web dashboard (Next.js BFF) — environment
# ---------------------------------------------------------------------------

# Server-side base URL of the Python backend. The Next.js /api/* route handlers
# (the BFF) proxy to `${PURSE_BACKEND_URL}/web/*`. The browser NEVER calls this
# directly. Example: https://purse-staging.fly.dev
PURSE_BACKEND_URL=http://localhost:8000

# The MCP URL shown on the public landing page and copied from the dashboard.
PURSE_MCP_URL=https://your-vault.dev/mcp

# Optional: when PURSE_BACKEND_URL is unset, the BFF serves built-in stub data
# so every screen renders without a live backend. Set this to "1" to ALSO fall
# back to stubs when a configured backend is unreachable (dev convenience only).
PURSE_ALLOW_STUB_FALLBACK=0

# Set to "1" in production behind HTTPS so the session cookie carries `Secure`.
# Leave unset/0 for local http dev or the cookie won't be stored by the browser.
# (Auto-enabled when NODE_ENV=production.)
PURSE_COOKIE_SECURE=0
